<!DOCTYPE html>
<html>
<head>
  <title>Profile</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="navbar">
    <div class="brand">Course Review Portal <span class="tag">VULNERABLE</span></div>
    <div><a href="/dashboard">Dashboard</a> <a href="/logout">Logout</a></div>
  </div>
  <div class="container">
    <div class="card">
      <h1>Profile: <%= username %></h1>
      <div id="bio"></div>
      <script>
        document.getElementById('bio').innerHTML = decodeURIComponent(location.hash.slice(1));
      </script>
      <div class="hint">
        DOM XSS demo: visit <code>/profile#&lt;img src=x onerror=alert('dom')&gt;</code>
      </div>
    </div>

    <div class="card">
      <h3>Update Email (no CSRF protection)</h3>
      <form method="POST" action="/update-email">
        <input name="email" placeholder="New email address">
        <button>Update</button>
      </form>
    </div>
  </div>
</body>
</html>