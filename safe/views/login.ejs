<!DOCTYPE html>
<html>
<head>
  <title>Login - Course Review Portal</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="navbar">
    <div class="brand">Course Review Portal <span class="tag">SAFE</span></div>
  </div>
  <div class="container">
    <div class="card">
      <h1>Sign in</h1>
      <% if (error) { %><div class="error-msg"><%= error %></div><% } %>
      <form method="POST" action="/login">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input name="username" placeholder="Username">
        <input name="password" type="password" placeholder="Password">
        <button type="submit">Login</button>
      </form>
      <div class="hint">
        Same payloads from the vulnerable version will fail here.
      </div>
    </div>
  </div>
</body>
</html>